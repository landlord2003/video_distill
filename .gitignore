# venv（含 Chromium，~150MB+，随项目拷贝，本地重建见 README）
venv/

# 运行时日志 / 测试产物
server.log
*.log
crawl_test_resp.json

# 抓取历史数据（按需决定是否入库，默认忽略）
crawls.db
crawls/*.md
crawls/*.fit.md
crawls/*.json

# Python 缓存
__pycache__/
*.pyc

# YouTube 凭据与下载产物（绝不入库）
yt_cookies.txt
proxy.txt
video_robot/

# 视频下载/抽帧产物与本地模型（大体积，绝不入库）
videos_inbox/
videos_frames/
whisper_models/
yt-dlp.exe
yt-dlp.exe.old
cookies.txt

# 本地调试临时文件与工作台数据
_*
tmp*.tmp*
_superseded_notes/
.workbuddy/
